# Razorpay Test Mode Credentials
# Generate these in Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Razorpay Webhook Secret
# Set when creating a webhook endpoint in Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret_here

# Microservice Port (default 8000)
PORT=8000
